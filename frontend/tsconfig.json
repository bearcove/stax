{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@bearcove/phon-engine": ["../../phon/typescript/packages/phon-engine/src/index.ts"],
      "@bearcove/phon-schema": ["../../phon/typescript/packages/phon-schema/src/index.ts"],
      "@bearcove/vox-core": ["../../vox/typescript/packages/vox-core/src/index.ts"],
      "@bearcove/vox-tcp": ["../../vox/typescript/packages/vox-tcp/src/index.ts"],
      "@bearcove/vox-wire": ["../../vox/typescript/packages/vox-wire/src/index.ts"],
      "@bearcove/vox-ws": ["../../vox/typescript/packages/vox-ws/src/index.ts"]
    },
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "useDefineForClassFields": true,
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["src"]
}
